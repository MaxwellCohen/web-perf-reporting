// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Timeline > renders thumbnail buttons for each timeline item 1`] = `"<div class="px-4"><h3 class="text-lg font-bold"> Timeline</h3><div class="mt-3 flex flex-row gap-2 align-top overflow-x-auto pb-2"><div class="shrink-0"><button type="button" aria-haspopup="dialog" aria-label="Open full-screen view at 100 ms" class="cursor-zoom-in rounded-md border-2 p-2 transition-transform hover:scale-105 hover:border-foreground/40"><img alt="timeline image at 100" width="80" loading="lazy" decoding="async" src="data:image/png;base64,a"><div>100 ms</div></button></div><div class="shrink-0"><button type="button" aria-haspopup="dialog" aria-label="Open full-screen view at 200 ms" class="cursor-zoom-in rounded-md border-2 p-2 transition-transform hover:scale-105 hover:border-foreground/40"><img alt="timeline image at 200" width="80" loading="lazy" decoding="async" src="data:image/png;base64,b"><div>200 ms</div></button></div></div></div>"`;

exports[`Timeline > renders timeline with device label 1`] = `"<div class="px-4"><h3 class="text-lg font-bold">Mobile -  Timeline</h3><div class="mt-3 flex flex-row gap-2 align-top overflow-x-auto pb-2"><div class="shrink-0"><button type="button" aria-haspopup="dialog" aria-label="Open full-screen view at 100 ms" class="cursor-zoom-in rounded-md border-2 p-2 transition-transform hover:scale-105 hover:border-foreground/40"><img alt="timeline image at 100" width="80" loading="lazy" decoding="async" src="data:image/png;base64,a"><div>100 ms</div></button></div><div class="shrink-0"><button type="button" aria-haspopup="dialog" aria-label="Open full-screen view at 200 ms" class="cursor-zoom-in rounded-md border-2 p-2 transition-transform hover:scale-105 hover:border-foreground/40"><img alt="timeline image at 200" width="80" loading="lazy" decoding="async" src="data:image/png;base64,b"><div>200 ms</div></button></div></div></div>"`;

exports[`Timeline > renders timeline without device label 1`] = `"<div class="px-4"><h3 class="text-lg font-bold"> Timeline</h3><div class="mt-3 flex flex-row gap-2 align-top overflow-x-auto pb-2"><div class="shrink-0"><button type="button" aria-haspopup="dialog" aria-label="Open full-screen view at 50 ms" class="cursor-zoom-in rounded-md border-2 p-2 transition-transform hover:scale-105 hover:border-foreground/40"><img alt="timeline image at 50" width="80" loading="lazy" decoding="async" src="data:image/png;base64,a"><div>50 ms</div></button></div></div></div>"`;
