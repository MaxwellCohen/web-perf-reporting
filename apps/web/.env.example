# Google PageSpeed Insights / CrUX API key (legacy unit tests; the web app no longer calls Google)
PAGESPEED_INSIGHTS_API=

# Turso is no longer used by the web app. History lives in the Void API's D1 database.
# TURSO_CONNECTION_URL=
# TURSO_AUTH_TOKEN=

# Canonical site URL for metadata, robots.txt, and sitemap.xml
NEXT_PUBLIC_SITE_URL=

# PostHog analytics (client)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Void API worker (server-side only). Set this after `void deploy` from apps/api.
WORKER_URL=https://web-perf-report-api.<account>.workers.dev
WORKER_API_KEY=

# Optional Sentry (defaults are baked into sentry.*.config.ts if unset)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
