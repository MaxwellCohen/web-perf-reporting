{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "vitest": {
    "config": "vitest.config.ts"
  },
  "ignore": ["src/components/ui/*.tsx"],
  "ignoreBinaries": ["fallow"],
  "rules": {
    // flatTableFeatures intentionally aliases standardTableFeatures (same bundle,
    // expander disabled at the hook). Not a copy-paste duplicate.
    "duplicates": "off"
  }
}
