{
  "name": "web-perf-reporting",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "test": "pnpm --filter web test && pnpm --filter api test && pnpm --filter @maxwellcohen/web-perf-report test",
    "build:cli": "pnpm --filter @maxwellcohen/web-perf-report build",
    "typecheck": "pnpm --filter web typecheck"
  },
  "pnpm": {
    "overrides": {
      "@sentry/node@9.47.1>minimatch": "10.2.4",
      "esbuild@<=0.24.2": ">=0.25.0",
      "brace-expansion@>=2.0.0 <2.0.3": ">=2.0.3",
      "brace-expansion@>=4.0.0 <5.0.5": ">=5.0.5",
      "brace-expansion@5.0.4": "5.0.5",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "drizzle-orm@<0.45.2": ">=0.45.2",
      "dompurify@<3.4.17": ">=3.4.17"
    }
  }
}
