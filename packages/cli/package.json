    "test:watch": "vitest",
    "lint:pkg": "publint"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "citty": "^0.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "publint": "^0.3.25",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
