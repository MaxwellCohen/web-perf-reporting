{
  "name": "@maxwellcohen/web-perf-report",
  "version": "0.1.0",
  "description": "Run Lighthouse on a URL and get a ranked, agent-ready performance report. CLI and local MCP server.",
  "license": "MIT",
  "author": "Maxwell Cohen",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaxwellCohen/web-perf-reporting.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/MaxwellCohen/web-perf-reporting#readme",
  "bugs": "https://github.com/MaxwellCohen/web-perf-reporting/issues",
  "keywords": [
    "lighthouse",
    "web-performance",
    "core-web-vitals",
    "mcp",
    "cli"
  ],
  "sideEffects": false,
  "bin": {
    "web-perf-report": "./dist/index.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
